  "ingredient_sections": [
    {
      "id": "dough",
      "title": "Dough",
      "ingredients": [
        {
          "id": "flour",
          "name": "bread flour",
          "quantity": {
            "kind": "simple",
            "amount": {
              "value": "500"
            },
            "unit": "mass.gram"
          },
          "source_text": "500 g bread flour"
        },
        {
          "id": "water",
          "name": "water",
          "quantity": {
            "kind": "simple",
            "amount": {
              "min": "350",
              "max": "375",
              "approximate": true
            },
            "unit": "mass.gram"
          },
          "source_text": "about 350–375 g water"
        },
        {
          "id": "starter",
          "name": "active sourdough starter",
          "quantity": {
            "kind": "simple",
            "amount": {
              "value": "100"
            },
            "unit": "mass.gram"
          },
          "source_text": "100 g active sourdough starter"
        },
        {
          "id": "salt",
          "name": "fine salt",
          "quantity": {
            "kind": "simple",
            "amount": {
              "value": "10"
            },
            "unit": "mass.gram"
          },
          "source_text": "10 g fine salt"
        },
        {
          "id": "rice-flour",
          "name": "rice flour",
          "quantity": {
            "kind": "opaque",
            "text": "enough for dusting"
          },
          "note": "for the proofing basket",
          "source_text": "rice flour, enough for dusting"
        }
      ]
    }
  ],
  "instruction_sections": [
    {
      "id": "method",
      "steps": [
        {
          "id": "mix",
          "text": "Mix the flour, most of the water, starter, and salt. Add the remaining water only as needed.",
          "ingredient_uses": [
            {"ingredient_ref": "flour"},
            {"ingredient_ref": "water"},
            {"ingredient_ref": "starter"},
            {"ingredient_ref": "salt"}
          ]
        },
        {
          "id": "ferment",
          "text": "Ferment and fold the dough until it is elastic and aerated."
        },
        {
          "id": "proof",
          "text": "Shape, place in a rice-floured basket, and proof until ready.",
          "ingredient_uses": [
            {"ingredient_ref": "rice-flour"}
          ]
        },
        {
          "id": "bake",
          "text": "Bake until deeply browned and cool completely before slicing."
        }
      ]
    }
  ]
