  "instruction_sections": [
    {
      "id": "make-cake",
      "title": "Make the cake layers",
      "steps": [
        {
          "id": "mix-cake",
          "text": "Cream the butter and sugar, beat in the eggs, then mix in the flour, baking powder, and milk until smooth.",
          "ingredient_uses": [
            {"ingredient_ref": "cake-flour"},
            {"ingredient_ref": "cake-eggs"},
            {"ingredient_ref": "cake-sugar"},
            {"ingredient_ref": "cake-butter"},
            {"ingredient_ref": "cake-milk"},
            {"ingredient_ref": "baking-powder"}
          ]
        },
        {
          "id": "bake-cake",
          "text": "Divide between two prepared pans and bake at 180 °C for about 25 minutes, until the centres spring back.",
          "timing_refs": ["bake-cake-time"],
          "temperatures": [
            {"amount": {"value": "180"}, "unit": "temperature.celsius", "purpose": {"kind": "oven"}, "source_text": "180 °C"}
          ]
        }
      ]
    },
    {
      "id": "make-filling",
      "title": "Make the filling",
      "steps": [
        {
          "id": "cook-filling",
          "text": "Cook the berries and sugar until thick, then cool.",
          "ingredient_uses": [
            {"ingredient_ref": "berries"},
            {"ingredient_ref": "filling-sugar"}
          ]
        }
      ]
    },
    {
      "id": "assemble",
      "title": "Assemble",
      "steps": [
        {
          "id": "make-frosting",
          "text": "Beat the butter and icing sugar until light.",
          "ingredient_uses": [
            {"ingredient_ref": "frosting-butter"},
            {"ingredient_ref": "icing-sugar"}
          ]
        },
        {
          "id": "fill-and-frost",
          "text": "Layer the cooled cakes with pastry cream and berry filling and cover with frosting.",
          "ingredient_uses": [
            {"ingredient_ref": "berries"},
            {"ingredient_ref": "pastry-cream"},
            {"ingredient_ref": "frosting-butter"},
            {"ingredient_ref": "icing-sugar"}
          ]
        }
      ]
    }
  ],
