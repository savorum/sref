    {"id": "shape", "title": "Divide and shape", "steps": [{"id": "divide", "text": "Divide the dough into two equal pieces, shape into balls, and let them relax at room temperature.", "timing_refs": ["shape-time"]}, {"id": "stretch", "text": "Stretch each ball into a round on a lightly floured surface.", "timing_refs": ["shape-time"], "ingredient_uses": [{"ingredient_ref": "bread-flour"}]}]},
